# Django
SECRET_KEY=your-super-secret-key-here
DEBUG=False
ALLOWED_HOSTS=shiftpilot-api.fly.dev,localhost

# Neon PostgreSQL
DATABASE_URL=postgres://user:password@ep-xxx.neon.tech/shiftpilot?sslmode=require

# Cloudflare R2
R2_BUCKET_NAME=shiftpilot-media
